{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          { "type": "command", "command": "python3 .codex/hooks/session-start-context.py", "timeout": 10 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|shell",
        "hooks": [
          { "type": "command", "command": "python3 .codex/hooks/guard-destructive.py", "timeout": 10 }
        ]
      },
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          { "type": "command", "command": "python3 .codex/hooks/guard-destructive.py", "timeout": 10 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          { "type": "command", "command": "python3 .codex/hooks/track-touched.py", "timeout": 5 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "python3 .codex/hooks/require-check-before-stop.py --command scripts/quick-check.sh --budget 120", "timeout": 150 }
        ]
      }
    ]
  }
}
