{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "feature_list",
  "type": "object",
  "required": ["features"],
  "properties": {
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "description", "priority", "verify", "passes"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "description": { "type": "string", "minLength": 10 },
          "priority": { "type": "integer", "minimum": 1 },
          "verify": { "type": "string", "minLength": 3, "description": "a command whose exit code proves the feature" },
          "passes": { "type": "boolean", "description": "set only by scripts/verify-feature.py" },
          "evidence": {
            "type": ["object", "null"],
            "properties": {
              "date": { "type": "string" },
              "command": { "type": "string" },
              "exit": { "type": "integer" }
            }
          }
        }
      }
    }
  }
}
