{
  "permissions": {
    "allow": [
      "Bash(make quick)",
      "Bash(make check)",
      "Bash(scripts/check.sh)",
      "Bash(bats tools/tests/)",
      "Bash(markdownlint-cli2:*)",
      "Bash(lychee:*)",
      "Bash(shellcheck:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/templates/hooks/scripts/guard-destructive.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/templates/hooks/scripts/require-check-before-stop.py\" --command \"make quick\" --root-marker Makefile --budget 60",
            "timeout": 90
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/templates/hooks/scripts/track-touched.py\"",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ]
  }
}
